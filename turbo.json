{
  "$schema": "https://v2-11-2.turborepo.dev/schema.json",
  "globalDependencies": [".env", ".env.local"],
  "globalEnv": ["NODE_ENV", "PORT"],
  "tasks": {
    "@opentask/taskin#build": {
      "dependsOn": ["install", "^build"],
      "outputs": []
    },
    "@taskin/chatbot#build": {
      "dependsOn": ["install", "^build"],
      "outputs": []
    },
    "@taskin/directus-extension#build": {
      "dependsOn": ["install", "^build"],
      "outputs": []
    },
    "@taskin/docs#build": {
      "dependsOn": ["install", "^build"],
      "outputs": ["content/.vitepress/dist/**"]
    },
    "@taskin/n8n-plugin#build": {
      "dependsOn": ["install", "^build"],
      "outputs": []
    },
    "@taskin/py-sdk#build": {
      "dependsOn": ["install", "^build"],
      "outputs": []
    },
    "@taskin/types-py#publish:pypi": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "build": {
      "dependsOn": ["install", "^build"],
      "inputs": [
        "src/**/*.{ts,js,tsx,jsx,vue}",
        "content/**",
        "package.json",
        "tsconfig.json",
        "index.html",
        "vite.config.ts",
        "public/**"
      ],
      "outputs": ["dist/**", "build/**", "generated/**", "content/.vitepress/dist/**", "dashboard-dist/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "dependsOn": ["install"],
      "persistent": true
    },
    "format": {
      "dependsOn": ["install"],
      "inputs": ["src/**/*.{ts,js,tsx,jsx,json}", "package.json"],
      "outputs": []
    },
    "format:check": {
      "dependsOn": ["install"],
      "inputs": ["src/**/*.{ts,js,tsx,jsx,json}", "package.json"],
      "outputs": []
    },
    "generate": {
      "dependsOn": ["^generate:schemas"],
      "outputs": ["generated/**"]
    },
    "generate:schemas": {
      "dependsOn": [],
      "outputs": ["dist/schema/**"]
    },
    "install": {
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "package.json",
        "pnpm-lock.yaml",
        "packages/*/package.json",
        "packages/*/pyproject.toml",
        "packages/*/uv.lock"
      ],
      "outputs": ["node_modules/**", ".venv/**"]
    },
    "lint": {
      "dependsOn": ["install"],
      "inputs": ["src/**/*.{ts,js,tsx,jsx}", "package.json", "tsconfig.json"],
      "outputs": []
    },
    "lint:fix": {
      "dependsOn": ["install"],
      "inputs": ["src/**/*.{ts,js,tsx,jsx}", "package.json", "tsconfig.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["install", "build"],
      "inputs": ["src/**/*.{ts,js,tsx,jsx}", "**/*.test.{ts,js}", "package.json"],
      "outputs": ["coverage/**", ".turbo/**"]
    },
    "test:coverage": {
      "dependsOn": ["install", "build"],
      "inputs": ["src/**/*.{ts,js,tsx,jsx}", "**/*.test.{ts,js}", "package.json"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["install", "^build"],
      "inputs": ["src/**/*.{ts,tsx}", "package.json", "tsconfig.json"],
      "outputs": []
    }
  }
}
