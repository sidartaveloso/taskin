{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "taskin-docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@taskin/docs",
        "run",
        "dev",
        "--port",
        "6100"
      ],
      "port": 6100
    },
    {
      "name": "storybook-design-vue",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@opentask/taskin-design-vue",
        "run",
        "storybook"
      ],
      "port": 6107
    },
    {
      "name": "storybook-ui-sense",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@opentask/ui-sense",
        "run",
        "storybook"
      ],
      "port": 6108
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "storybook"
      ],
      "port": 6106
    },
    {
      "name": "taskin-dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "taskin",
        "dashboard",
        "--open",
        "--port",
        "6110",
        "--ws-port",
        "6111"
      ],
      "port": 6110
    }
  ]
}
