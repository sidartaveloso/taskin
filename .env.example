# Taskin - Notification Environment Variables
# Copy this file to .env and fill in your values.
# These values are used at runtime via ${VAR_NAME} in .taskin.json.
# They never get stored in git or in the config file.

# Discord webhook URL for task notifications
DISCORD_TASKIN_WEBHOOK_URL=

# Telegram bot token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram chat/group ID (negative for groups)
TELEGRAM_CHAT_ID=
