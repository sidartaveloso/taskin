{
  "version": "1.0.3",
  "automation": {
    "level": "autopilot",
    "autoSync": true,
    "defaultBranch": "develop",
    "ciSkipTag": "[skip ci]"
  },
  "provider": {
    "type": "fs",
    "config": {
      "tasksDir": "TASKS"
    }
  },
  "hooks": {
    "review": {
      "pre": ["git fetch origin", "git status --porcelain", "git pull --rebase origin {{baseBranch}}"],
      "during": ["pnpm lint", "pnpm typecheck", "pnpm test"],
      "post": ["git push origin HEAD", "echo '✓ Task {{taskId}} ({{taskTitle}}) ready for review!'"]
    }
  },
  "hookConfig": {
    "baseBranch": "develop",
    "continueOnError": false,
    "timeout": 300000
  },
  "notifications": {
    "discord": {
      "webhookUrl": "${DISCORD_TASKIN_WEBHOOK_URL}",
      "events": ["task:start", "task:done"]
    }
  }
}
