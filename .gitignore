# materializa o seu store aqui quando nao encontra o do host.
.pnpm-store/
.pnp
.pnp.js

# Testing
coverage/
.nyc_output/
__screenshots__/
test-results/
playwright-report/
blob-report/
.playwright/
test-results-report.html

# Build outputs
dist/
dist-app/
dashboard-dist/
build/
*.tsbuildinfo

# Generated files in src (should only be in dist)
**/src/**/*.js
**/src/**/*.d.ts
**/src/**/*.map
!**/src/**/*.test.ts
!**/src/**/*.stories.ts
!**/.storybook/**

# Package tarballs
**/*.tgz

# Turbo
.turbo/

