{
  "name": "taskin-monorepo",
  "private": true,
  "type": "module",
  "version": "1.0.13",
  "description": "Taskin monorepo for task management and automation",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.20.0"
  },
  "author": {
    "name": "OpenTask",
    "url": "https://opentask.com.br"
  },
  "contributors": [
    {
      "name": "Sidarta Veloso",
      "github": "https://github.com/sidartaveloso",
      "gitlab": "https://gitlab.com/sidartaveloso",
      "linkedin": "https://www.linkedin.com/in/sidartaveloso"
    }
  ],
  "scripts": {
    "build": "turbo run build",
    "build:storybook": "storybook build",
    "changeset": "changeset",
    "changeset:publish": "pnpm build && changeset publish",
    "changeset:version": "changeset version && pnpm install --no-frozen-lockfile",
    "ci": "pnpm typecheck && pnpm lint && pnpm test",
    "clean": "turbo run clean",
    "confianca:publicacao": "tsx dev/scripts/configurar-confianca-de-publicacao.ts",
    "dev": "turbo run dev --parallel",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "generate:py-types": "pnpm --filter @taskin/types-py run generate",
    "install": "echo 'Installing taskin-monorepo dependencies...'",
    "lint": "turbo run lint && pnpm run lint:manifests && pnpm run lint:repository-url && pnpm run lint:tasks && pnpm run lint:root",
    "lint:fix": "turbo run lint:fix",
    "lint:manifests": "tsx dev/scripts/lint-manifests.ts",
    "lint:repository-url": "tsx dev/scripts/validar-repository-url.ts",
    "lint:root": "biome check .",
    "lint:tasks": "tsx dev/scripts/lint-tasks.ts",
    "pnpm:update": "pnpm install pnpm@latest -Dw",
    "publish:beta": "node scripts/publish-packages.js --tag beta",
    "publish:latest": "node scripts/publish-packages.js --tag latest",
    "publish:packages": "node scripts/publish-packages.js",
    "publish:pypi": "turbo run publish:pypi",
    "reconcile:tags": "tsx dev/scripts/reconciliar-tags.ts",
    "publish:pypi:check": "turbo run publish:pypi:check",
    "storybook": "storybook dev -p 6106",
    "storybook:all": "pnpm --parallel --filter @opentask/taskin-design-vue --filter @opentask/ui-sense storybook",
    "sync:versions": "node scripts/sync-versions.js",
    "taskin": "tsx packages/cli/src/index.ts",
    "test": "turbo run test && pnpm test:dev-scripts",
    "test:coverage": "turbo run test:coverage",
    "test:dev-scripts": "vitest run --config dev/vitest.config.ts",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@biomejs/biome": "^2.5.11",
    "@changesets/cli": "^3.0.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/vue3-vite": "^10.6.0",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.0",
    "storytype": "^0.4.0",
    "tsx": "^4.23.13",
    "turbo": "2.10.12",
    "typescript": "^7.0.2",
    "vite": "6.4.1",
    "vite-svg-loader": "^5.1.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.42"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vitepress": "1.6.4",
    "zod": "^4.5.4"
  }
}
