{
  "name": "@opentask/ui-sense",
  "version": "0.1.0",
  "description": "Vue 3 sensor and gesture components for adaptive UIs — face tracking, pose tracking, gesture recognition, and user sensitivity detection",
  "motivation": "To provide sensor and gesture-based Vue 3 components for adaptive, context-aware UIs.",
  "solve": "Wraps MediaPipe and other sensor APIs into declarative Vue components for face tracking, pose tracking, and gesture recognition.",
  "scope": "ui-component",
  "status": "active",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./dist/index.css": "./dist/index.css",
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "ui-sense",
    "face-tracking",
    "gesture-recognition",
    "pose-tracking",
    "vue3",
    "components",
    "sensors",
    "adaptive-ui"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "typescript": "^6.0.0",
    "vite": "^6.4.1",
    "vite-svg-loader": "^5.1.0",
    "vitest": "^4.0.16",
    "vue": "^3.5.26",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.22-rc.20250304"
  }
}
