{
  "name": "@opentask/taskin-utils",
  "version": "1.1.1",
  "private": false,
  "type": "module",
  "description": "Utility functions for Taskin",
  "motivation": "To provide reusable utility functions across the Taskin monorepo.",
  "solve": "Centralizes common utilities like UI helpers, formatting, and shared helper functions.",
  "scope": "internal",
  "status": "active",
  "since": "2025-11-05",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && node ../../scripts/fix-esm-extensions.mjs dist",
    "clean": "rm -rf dist coverage .turbo",
    "dev": "tsc --watch",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.11.5",
    "typescript": "^6.0.0"
  }
}
